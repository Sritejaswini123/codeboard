{
  "name": "board",
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "migrations:gen": "npm run build && drizzle-kit generate",
    "migrations:apply": "dotenvx run -- drizzle-kit migrate",
    "studio": "dotenvx run -- drizzle-kit studio",
    "seed": "ts-node src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.828.0",
    "@aws-sdk/s3-request-presigner": "^3.828.0",
    "@baselime/pino-transport": "^0.1.5",
    "@dotenvx/dotenvx": "^1.43.0",
    "@hono/node-server": "^1.14.1",
    "@ngneat/falso": "^7.3.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "drizzle-seed": "^0.3.1",
    "hono": "^4.7.10",
    "hono-pino": "^0.8.0",
    "multer": "^2.0.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nanoid": "^5.1.5",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.26.0",
    "eslint-plugin-format": "^1.0.1",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
